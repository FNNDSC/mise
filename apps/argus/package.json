{
  "name": "@fnndsc/argus",
  "version": "0.7.3",
  "description": "ARGUS: the LCARS web surface for mise — a browser console over a calypso session",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "test": "tsc --noEmit && NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "smoke": "node tests/smoke/smoke.mjs",
    "sounds": "node scripts/sounds_make.mjs"
  },
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "dependencies": {
    "@cornerstonejs/adapters": "^5.8.2",
    "@cornerstonejs/core": "^5.8.2",
    "@cornerstonejs/dicom-image-loader": "^5.8.2",
    "@cornerstonejs/metadata": "^5.8.2",
    "@cornerstonejs/tools": "^5.8.2",
    "@cornerstonejs/utils": "^5.8.2",
    "@fnndsc/menu": "^0.8.0",
    "@kitware/vtk.js": "^36.4.1",
    "@niivue/niivue": "^0.69.0",
    "@types/three": "^0.185.4",
    "buffer": "^6.0.3",
    "d3-array": "^3.2.4",
    "d3-force-3d": "^3.0.6",
    "d3-interpolate": "^3.0.1",
    "gl-matrix": "^3.4.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0",
    "vite": "^7.1.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
