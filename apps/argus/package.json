{
  "name": "@fnndsc/argus",
  "version": "0.0.0",
  "private": true,
  "description": "ARGUS: an LCARS web console and terminal surface for mise, attached to a CALYPSO session",
  "type": "module",
  "scripts": {
    "theme": "node scripts/theme_ensure.mjs",
    "build": "npm run theme && tsc --noEmit && vite build",
    "dev": "npm run theme && vite",
    "test": "tsc --noEmit",
    "smoke": "node tests/smoke/smoke.mjs"
  },
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "dependencies": {
    "@fnndsc/calypso": "*",
    "@fnndsc/menu": "*",
    "@types/three": "^0.185.4",
    "d3-force-3d": "^3.0.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.1.0"
  }
}
