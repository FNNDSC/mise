# /etc/porter.env — read once at start. Mode 0600: the secret lives here.
PORTER_CUBE_URL=https://ekanite.tch.harvard.edu:32223/api/v1/
PORTER_STATE_DIR=/var/lib/porter/sessions
PORTER_HOST=127.0.0.1
PORTER_PORT=4180
# At least twenty characters. Without it every browser is asked again at a restart.
PORTER_SECRET=change-me-to-something-long-and-private
# The chell that starts sessions; the one installed with the checkout by default.
PORTER_CHELL=/opt/mise/packages/chell/dist/index.js
# A day each, so a cookie and the session it names die together.
PORTER_COOKIE_HOURS=24
PORTER_IDLE_HOURS=24
