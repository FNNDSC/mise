{
  "name": "@fnndsc/porter",
  "version": "0.1.0",
  "private": true,
  "description": "PORTER: the mise display manager \u2014 logs an operator in, finds or starts their calypso, and shows them to argus",
  "type": "module",
  "main": "dist/porter.js",
  "bin": {
    "porter": "dist/porter.js"
  },
  "scripts": {
    "build": "rm -fr dist && tsc && chmod +x ./dist/porter.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "start": "node dist/porter.js"
  },
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "dependencies": {
    "@fastify/reply-from": "^12.6.5",
    "@fnndsc/calypso": "^0.15.2",
    "@fnndsc/chell": "^5.8.1",
    "fastify": "^5.12.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNNDSC/mise.git",
