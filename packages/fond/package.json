{
  "name": "@fnndsc/fond",
  "version": "0.2.0",
  "description": "The pieces every layer of mise needs, whatever the backend. Depends on nothing in @fnndsc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNNDSC/mise.git",
    "directory": "packages/fond"
  },
  "homepage": "https://github.com/FNNDSC/mise/tree/main/packages/fond#readme",
  "bugs": {
    "url": "https://github.com/FNNDSC/mise/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc",
    "test": "jest --coverage",
    "prepublishOnly": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "keywords": [
    "chris",
    "mise",
    "fnndsc"
  ],
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  }
}
