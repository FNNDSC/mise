{
  "name": "@fnndsc/menu",
  "version": "0.3.1",
  "description": "The mise wire contract: envelope, session protocol, and result-model schemas that surfaces and the kernel both speak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNNDSC/mise.git",
    "directory": "packages/menu"
  },
  "homepage": "https://github.com/FNNDSC/mise/tree/main/packages/menu#readme",
  "bugs": {
    "url": "https://github.com/FNNDSC/mise/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "prepublishOnly": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "keywords": [
    "chris",
    "mise",
    "wire-contract",
    "schema",
    "fnndsc"
  ],
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "type": "module"
}
